<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Test call — {{ account_label }}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #0f1115;
    --panel: #171a21;
    --border: #2a2e38;
    --text: #e6e8ec;
    --muted: #9aa1ad;
    --accent: #5b8cff;
    --ok: #3ecf8e;
    --warn: #f5a623;
    --err: #ef5959;
    --tool: #c98bff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
    font: 14px/1.5 -apple-system, Segoe UI, Roboto, sans-serif;
  }
  h1 { font-size: 16px; font-weight: 600; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
  }
  .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  button {
    font: inherit;
    padding: 9px 18px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: #232733;
    color: var(--text);
    cursor: pointer;
  }
  button:hover:not(:disabled) { border-color: var(--accent); }
  button:disabled { opacity: 0.4; cursor: not-allowed; }
  #startBtn { background: var(--accent); border-color: var(--accent); color: #fff; }
  #stopBtn { background: var(--err); border-color: var(--err); color: #fff; }
  .status-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--muted); display: inline-block; flex: none;
  }
  .status-dot.connecting { background: var(--warn); }
  .status-dot.active { background: var(--ok); box-shadow: 0 0 0 3px rgba(62,207,142,0.2); }
  .status-dot.error { background: var(--err); }
  #statusText { font-weight: 600; }
  #callId { color: var(--muted); font-size: 12px; margin-left: auto; }
  #callId.set { color: var(--text); font-family: ui-monospace, monospace; }
  pre {
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 260px;
    overflow-y: auto;
    margin: 0;
    font-size: 12.5px;
  }
  #log {
    height: 380px;
    overflow-y: auto;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .entry { padding: 3px 6px; border-radius: 4px; white-space: pre-wrap; word-break: break-word; }
  .entry .t { color: var(--muted); margin-right: 8px; }
  .entry.event-call-start, .entry.event-call-end { color: var(--accent); }
  .entry.event-error { background: rgba(239,89,89,0.12); color: var(--err); }
  .entry.event-tool { background: rgba(201,139,255,0.12); color: var(--tool); font-weight: 600; }
  .entry.event-speech { color: var(--muted); }
  details summary { cursor: pointer; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
  <h1>{{ account_label }}</h1>
  <div class="sub">Generated by <code>test-call --dial</code> &mdash; assistant {{ assistant_id }}</div>

  <div class="panel row">
    <button id="startBtn">Start Call</button>
    <button id="stopBtn" disabled>Stop</button>
    <span class="status-dot" id="statusDot"></span>
    <span id="statusText">idle</span>
    <span id="callId"></span>
  </div>

  <div class="panel">
    <details>
      <summary>Rendered system prompt</summary>
      <pre>{{ system_prompt }}</pre>
    </details>
  </div>

  <div class="panel">
    <div class="sub">Event log</div>
    <div id="log"></div>
  </div>

  <script id="config-data" type="application/json">{{ config_json | safe }}</script>
  <script src="https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js"></script>
  <script>
    const CONFIG = JSON.parse(document.getElementById('config-data').textContent);

    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    const callIdEl = document.getElementById('callId');
    const logEl = document.getElementById('log');

    function log(message, cls) {
      const line = document.createElement('div');
      line.className = 'entry' + (cls ? ' ' + cls : '');
      const time = document.createElement('span');
      time.className = 't';
      time.textContent = new Date().toLocaleTimeString();
      line.appendChild(time);
      line.appendChild(document.createTextNode(message));
      logEl.appendChild(line);
      logEl.scrollTop = logEl.scrollHeight;
    }

    function setStatus(text, cls) {
      statusText.textContent = text;
      statusDot.className = 'status-dot' + (cls ? ' ' + cls : '');
    }

    if (!CONFIG.publicKey) {
      setStatus('missing public key', 'error');
      log('No VAPI_PUBLIC_KEY configured — set it in .env and re-run `test-call --dial`.', 'event-error');
      startBtn.disabled = true;
    } else if (!window.vapiSDK) {
      setStatus('SDK failed to load', 'error');
      log('window.vapiSDK is undefined — the CDN script did not load (check network/adblock).', 'event-error');
      startBtn.disabled = true;
    }

    let vapi = null;

    function initVapi() {
      if (vapi) return vapi;
      vapi = window.vapiSDK.run({
        apiKey: CONFIG.publicKey,
        assistant: CONFIG.assistantId,
        assistantOverrides: CONFIG.assistantOverrides,
      });
      // The CDN loader auto-injects its own floating call button; we drive `vapi`
      // directly from our own controls instead, so hide it.
      const defaultBtn = document.getElementById('vapi-support-btn');
      if (defaultBtn) defaultBtn.style.display = 'none';

      vapi.on('call-start', () => {
        setStatus('connected', 'active');
        log('call-start', 'event-call-start');
      });
      vapi.on('call-start-progress', (e) => {
        log('call-start-progress: ' + JSON.stringify(e));
      });
      vapi.on('call-start-success', (e) => {
        if (e && e.callId) {
          callIdEl.textContent = e.callId;
          callIdEl.classList.add('set');
        }
        log('call-start-success: ' + JSON.stringify(e));
      });
      vapi.on('call-start-failed', (e) => {
        setStatus('failed to connect', 'error');
        log('call-start-failed: ' + JSON.stringify(e), 'event-error');
        startBtn.disabled = false;
        stopBtn.disabled = true;
      });
      vapi.on('call-end', () => {
        setStatus('ended', '');
        log('call-end', 'event-call-end');
        startBtn.disabled = false;
        stopBtn.disabled = true;
      });
      vapi.on('speech-start', () => log('speech-start', 'event-speech'));
      vapi.on('speech-end', () => log('speech-end', 'event-speech'));
      vapi.on('error', (e) => {
        log('error: ' + JSON.stringify(e), 'event-error');
      });
      vapi.on('message', (message) => {
        const type = (message && message.type) || '';
        const isTool = /tool|function/i.test(type);
        log('message [' + type + ']: ' + JSON.stringify(message), isTool ? 'event-tool' : '');
      });
      return vapi;
    }

    startBtn.addEventListener('click', async () => {
      startBtn.disabled = true;
      setStatus('connecting...', 'connecting');
      log('requesting microphone + starting call...');
      try {
        const instance = initVapi();
        const call = await instance.start(CONFIG.assistantId, CONFIG.assistantOverrides);
        if (call && call.id) {
          callIdEl.textContent = call.id;
          callIdEl.classList.add('set');
        }
        stopBtn.disabled = false;
      } catch (err) {
        setStatus('failed to start', 'error');
        log('start() threw: ' + (err && err.message ? err.message : String(err)), 'event-error');
        startBtn.disabled = false;
      }
    });

    stopBtn.addEventListener('click', () => {
      if (vapi) vapi.stop();
      stopBtn.disabled = true;
    });
  </script>
</body>
</html>
