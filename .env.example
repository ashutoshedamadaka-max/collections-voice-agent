# Copy to .env and fill in. Never commit the real .env.

# Google Sheets (Step 0) — create a Sheet, share it with the service account's
# client_email as Editor, then set these two:
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# OpenAI (Step 4 post-call specialists, and Vapi's in-call backend model in Step 2 —
# deliberately NOT Anthropic: no Anthropic credit, only $8 OpenAI / $7 Vapi)
OPENAI_API_KEY=

# Vapi (Step 2)
VAPI_API_KEY=
VAPI_SERVER_SECRET=
VAPI_ASSISTANT_ID=
# Public key, not the private API key above — Vapi Dashboard -> API Keys. Shipped to the
# browser by `test-call --dial` (fixtures/test_call.html) for the client-side Web SDK.
VAPI_PUBLIC_KEY=
# Add your OpenAI key to Vapi Dashboard -> Provider Keys, then paste the resulting
# credential id here so in-call model usage bills your OpenAI balance, not Vapi credits.
VAPI_OPENAI_CREDENTIAL_ID=

# Voice-agent persona
COMPANY_NAME=Acme Supplies

# Post-call supervisor gating (Step 4/5)
CONFIDENCE_THRESHOLD=0.75

# Local webhook server (Step 2)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
