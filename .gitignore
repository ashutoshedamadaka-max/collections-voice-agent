# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local config
.env
*service-account*.json
service_account.json

# Generated / fetched data — not meant to be committed
fixtures/fake_ar_data.json
fixtures/transcripts/*.json
fixtures/expected_outcomes/*.json
!fixtures/transcripts/.gitkeep
!fixtures/expected_outcomes/.gitkeep

# Generated by `test-call --dial` — embeds a live account's real context pack + public key
fixtures/test_call.html

# Runtime logs from live/test calls — not meant to be committed
fixtures/tool_calls.jsonl
fixtures/webhook_requests.jsonl

# Demo console cap-tracking state (visitor/day counts, cumulative spend) — runtime state,
# not fixture data.
fixtures/demo_state.db

# Eval pipeline-run cache (fixtures/eval/pipeline_runs/) — regenerable any time via
# `run-eval --refresh`, pure API output with no human effort invested, unlike
# fixtures/eval/labels.json (the human labels themselves), which IS committed.
fixtures/eval/pipeline_runs/*.json
!fixtures/eval/pipeline_runs/.gitkeep

.pytest_cache/
